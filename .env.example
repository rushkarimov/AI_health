# Скопируй в .env и заполни. Обязательные помечены — без них бот не стартует.

# ---------------------------------------------------------------- Telegram
BOT_TOKEN=                       # обязательно, от @BotFather
BOT_USERNAME=                    # без @, нужен для ссылок вида t.me/<bot>?start=
ALLOWED_USER_IDS=                # через запятую; пусто — пускаем всех
INVITE_CODE=                     # общий секрет для API-клиентов

# ---------------------------------------------------------------- Postgres
POSTGRES_HOST=postgres           # имя сервиса в docker-compose
POSTGRES_PORT=5432
POSTGRES_DB=healthbot
POSTGRES_USER=healthbot
POSTGRES_PASSWORD=               # обязательно

# ------------------------------------------------------------------ модели
# Провайдер выбирается отдельно для текста, картинок и речи.
# шлюз к OpenAI/Google/Anthropic с оплатой картой РФ.
LLM_PROVIDER=            
VISION_PROVIDER=
STT_PROVIDER=

RouterAI_API_KEY=                # регистр важен: читается ровно так
ROUTERAI_LLM_MODEL=
ROUTERAI_VISION_MODEL=
ROUTERAI_STT_MODEL=

# запасной путь
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_LLM_MODEL=
YANDEX_VISION_MODEL=

# прямые ключи, если ходить в провайдера без шлюза
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --------------------------------------------------------- база знаний RAG
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                  # без него панель Qdrant открыта всем

# ------------------------------------------------------------ наблюдаемость
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGSMITH_API_KEY=               # опционально, для LangGraph Studio

# Секреты самого Langfuse, если поднимаешь его рядом
# (docker-compose.langfuse.yml). Сгенерировать свои:
#   openssl rand -hex 16  → LANGFUSE_SALT
#   openssl rand -hex 32  → LANGFUSE_ENCRYPTION_KEY
#   openssl rand -hex 24  → LANGFUSE_NEXTAUTH_SECRET
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_PG_PASSWORD=            # пароль внутренней БД Langfuse
LANGFUSE_CH_PASSWORD=            # пароль ClickHouse
LANGFUSE_MINIO_PASSWORD=         # пароль MinIO (хранилище трейсов)
LANGCHAIN_API_KEY=

# ------------------------------------------------------- выгрузка из часов
HEALTH_API_TOKEN=                # токен для /health/* — «Команды» на iPhone
FITBIT_CLIENT_ID=                # Google Health / Fitbit, опционально
FITBIT_CLIENT_SECRET=

# ------------------------------------------------------------- веб-поиск
# Ключи не нужны: используется DuckDuckGo. Оставлены для совместимости.
TAVILY_API_KEY=
BRAVE_API_KEY=

# --------------------------------------------------------------- поведение
TZ=Europe/Moscow
API_PORT=8080
SCHEDULER_ENABLED=1              # 0 — выключить дайджесты и алерты
DIGEST_HOUR=12                   # утренняя сводка
DIGEST_MINUTE=0
EVENING_HOUR=0                   # вечерний итог
EVENING_MINUTE=0
INSIGHT_WEEKDAY=0                # 0 — понедельник, недельный разбор
WEIGH_REMINDER_DAYS=7            # молчит N дней — напомнить взвеситься
COMBINE_WINDOW_SEC=90            # фото и подпись к нему считаем одним приёмом
CONFIDENCE_THRESHOLD_PHOTO=0.5   # ниже — переспросим вес
CONFIDENCE_THRESHOLD_VOICE=0.4
